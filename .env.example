# Keep the real .env outside version control, readable only by you: chmod 600 .env
# Leave credentials blank for local drafting and anonymous Reverb research.
# Upgrading from Anthropic: set OPENAI_API_KEY and replace or remove any old VISION_MODEL=claude-* pin.
OPENAI_API_KEY=
VISION_MODEL=gpt-4.1-mini

# Personal token: public, read_profile, read_listings, write_listings for later publication.
# A read-only history token cannot publish. Preparation and final publication need separate grants.
REVERB_API_TOKEN=
REVERB_BASE_URL=https://api.reverb.com/api
EXPECTED_SHOP_ID=1333667
EXPECTED_SHOP_SLUG=bounceconnection
# Separately authorized sandbox: https://sandbox.reverb.com/api + its own token/shop identity.
# Keep production preparation AND first publication blocked until separately authorized
# processed-gallery/independent-cover qualification and permission. Status remains read-only.
# The old REVERB_EXACT_PHOTOS_CONFIRMED setting is ignored, including old true values.
REVERB_PROCESSED_PHOTO_REVIEW_CONFIRMED=false

# Already-provisioned PRIVATE R2 bucket. No public bucket URL is required.
# Configure enabled one-day object expiry for synthshop/; lifecycle-read access is required.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=synthshop

# DATA_DIR defaults to ~/.synthshop; use a dedicated private directory, never a shared root.
# DATA_DIR=/absolute/private/synthshop-data
# Existing product JSON records are imported once and left untouched.
PRODUCTS_DIR=products
